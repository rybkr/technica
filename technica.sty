\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{technica}[2026/10/15 Technical writing style system]

% Package entry point: select modules and forward their options. Presentation
% defaults and implementations belong to the individual technica-* packages.

\RequirePackage{kvoptions}
% Keep entry-point option storage separate from each module's internal macros.
\SetupKeyvalOptions{family=technica, prefix=technica@main@}

% Global document styling (fonts and layout) is opt-in. Component modules
% remain enabled by default. Each *opts value is a braced option list passed
% through to its module, and is ignored when that module is disabled.
% Empty switch values mean "inherit the preset". Resolve them only after all
% options are parsed, so explicit true/false always wins over style and layout.
\DeclareStringOption[]{style}
\DeclareStringOption[]{fonts}[true]
\DeclareStringOption[]{headings}[true]
\DeclareStringOption[]{paragraphs}[true]
\DeclareStringOption[]{lists}[true]
\DeclareStringOption[]{captions}[true]
\DeclareStringOption[]{pagecolors}[true]
\DeclareStringOption[]{hyperlinks}[true]
\DeclareStringOption{fontopts}

\DeclareStringOption{coloropts}
% Empty means no override: technica-colors owns the default (light), and a
% theme supplied through coloropts remains usable.
\DeclareStringOption[]{theme}

\DeclareBoolOption[false]{layout}
\DeclareStringOption{layoutopts}

\DeclareBoolOption[true]{code}
\DeclareStringOption{codeopts}

\DeclareBoolOption[true]{boxes}
\DeclareStringOption{boxopts}

\DeclareBoolOption[true]{macros}
\DeclareStringOption{macroopts}

\ProcessKeyvalOptions*

\def\technica@main@all{all}
\ifx\technica@main@style\@empty\else
    \ifx\technica@main@style\technica@main@all\else
        \PackageError{technica}{Unknown style `\technica@main@style'}{Use style=all or omit style.}
    \fi
\fi
\def\technica@main@forwardstyles{%
    % Resolved switches follow layoutopts so wrapper controls remain authoritative.
    \@for\technica@main@feature:=headings,paragraphs,lists,captions,pagecolors,hyperlinks\do{%
        \csname iftechnica@main@\technica@main@feature enabled\endcsname
            \edef\technica@main@option{\technica@main@feature=true}%
        \else
            \edef\technica@main@option{\technica@main@feature=false}%
        \fi
        \expandafter\PassOptionsToPackage\expandafter{\technica@main@option}{technica-layout}%
    }
}

\newif\iftechnica@main@loadlayout
\def\technica@main@resolve#1#2{%
    \expandafter\newif\csname iftechnica@main@#1enabled\endcsname
    \csname technica@main@#1enabled#2\endcsname
    \ifx\technica@main@style\technica@main@all
        \csname technica@main@#1enabledtrue\endcsname
    \fi
    \expandafter\let\expandafter\technica@main@value\csname technica@main@#1\endcsname
    \ifx\technica@main@value\@empty\else
        \def\technica@main@true{true}%
        \def\technica@main@false{false}%
        \ifx\technica@main@value\technica@main@true
            \csname technica@main@#1enabledtrue\endcsname
        \else\ifx\technica@main@value\technica@main@false
            \csname technica@main@#1enabledfalse\endcsname
        \else
            \PackageError{technica}{Invalid value for #1}{Use true or false.}%
        \fi\fi
    \fi
}
\technica@main@resolve{fonts}{false}
\@for\technica@main@feature:=headings,paragraphs,lists,captions,pagecolors,hyperlinks\do{%
    \def\technica@main@default{false}%
    \iftechnica@main@layout
        \def\technica@main@default{true}%
    \fi
    \def\technica@main@pagecolorsname{pagecolors}%
    \def\technica@main@hyperlinksname{hyperlinks}%
    \ifx\technica@main@feature\technica@main@pagecolorsname
        \def\technica@main@default{false}%
    \fi
    \ifx\technica@main@feature\technica@main@hyperlinksname
        \def\technica@main@default{false}%
    \fi
    \technica@main@resolve{\technica@main@feature}{\technica@main@default}%
    \csname iftechnica@main@\technica@main@feature enabled\endcsname
        \technica@main@loadlayouttrue
    \fi
}

% Queue palette options before any module can load technica-colors. Colors are
% loaded on demand by the enabled modules, not unconditionally by this wrapper.
\ifx\technica@main@coloropts\@empty\else
    \PassOptionsToPackage{\technica@main@coloropts}{technica-colors}
\fi

\ifx\technica@main@theme\@empty\else
    \PassOptionsToPackage{theme={\technica@main@theme}}{technica-colors}
\fi

% Load fonts first to establish the heading family used by boxes and layout.
% The remaining order is conventional: modules declare their own dependencies
% and provide heading fallbacks when fonts are disabled. Forward options before
% each RequirePackage so they are available during that module's initialization.
\iftechnica@main@fontsenabled
    \ifx\technica@main@fontopts\@empty\else
        \PassOptionsToPackage{\technica@main@fontopts}{technica-fonts}
    \fi
    \RequirePackage{technica-fonts}
\fi

\iftechnica@main@code
    \ifx\technica@main@codeopts\@empty\else
        \PassOptionsToPackage{\technica@main@codeopts}{technica-code}
    \fi
    \RequirePackage{technica-code}
\fi

\iftechnica@main@boxes
    \ifx\technica@main@boxopts\@empty\else
        \PassOptionsToPackage{\technica@main@boxopts}{technica-boxes}
    \fi
    \RequirePackage{technica-boxes}
\fi

\iftechnica@main@loadlayout
    \ifx\technica@main@layoutopts\@empty\else
        \PassOptionsToPackage{\technica@main@layoutopts}{technica-layout}
    \fi
    \technica@main@forwardstyles
    \RequirePackage{technica-layout}
\fi

\iftechnica@main@macros
    \ifx\technica@main@macroopts\@empty\else
        \PassOptionsToPackage{\technica@main@macroopts}{technica-macros}
    \fi
    \RequirePackage{technica-macros}
\fi

\endinput
