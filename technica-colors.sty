\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{technica-colors}[2026/10/11 Technica color palette]

% ------------------------------------------------------------------------------
% Purpose
% ------------------------------------------------------------------------------
% Defines the Technica named color palette and a lightweight alias system.
% Raw colors own a hex value; semantic tokens alias into raw colors so that
% redefining a raw color propagates to all aliases automatically.
%
% Public interface:
%   \technicadefinecolor{<name>}{<RRGGBB>}
%     Defines a raw color and a \<name>Hex macro for the hex string.
%     Replaces any alias of the same name and refreshes dependent aliases.
%
%   \technicaaliascolor{<name>}{<target>}
%     Binds <name> to a named <target> via \colorlet, replacing its old binding.
%     Refreshes dependents immediately. Cycles are rejected.
% ------------------------------------------------------------------------------

\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=technica, prefix=technica@colors@}

\DeclareStringOption[light]{theme}

\ProcessKeyvalOptions*

\RequirePackage[table,dvipsnames,svgnames,x11names]{xcolor}
\RequirePackage{expl3}

\ExplSyntaxOn

% Bindings have the same scope as xcolor definitions. Store only the current
% target, rather than a history whose replay could undo later overrides.
\prop_new:N \l__technica_color_aliases_prop
\tl_new:N \l__technica_color_target_tl
\tl_new:N \l__technica_color_hex_tl
\bool_new:N \l__technica_color_cycle_bool

\cs_new_protected:Npn \__technica_refresh_color:n #1
  {
    \prop_get:NnNT \l__technica_color_aliases_prop {#1}
      \l__technica_color_target_tl
      {
        \exp_args:NnV \__technica_refresh_alias:nn {#1}
          \l__technica_color_target_tl
      }
  }

\cs_new_protected:Npn \__technica_refresh_alias:nn #1#2
  {
    % Resolve the upstream color first, irrespective of insertion order.
    \__technica_refresh_color:n {#2}
    \colorlet{#1}{#2}
    \convertcolorspec{named}{#2}{HTML}\l__technica_color_hex_tl
    \cs_set:cpx {#1Hex} {\l__technica_color_hex_tl}
  }

\cs_new_protected:Npn \__technica_refresh_colors:
  {
    \prop_map_inline:Nn \l__technica_color_aliases_prop
      {\__technica_refresh_alias:nn {##1} {##2}}
  }

\cs_new_protected:Npn \__technica_check_color_cycle:nn #1#2
  {
    \str_if_eq:nnTF {#1} {#2}
      {\bool_set_true:N \l__technica_color_cycle_bool}
      {
        \prop_get:NnNT \l__technica_color_aliases_prop {#2}
          \l__technica_color_target_tl
          {
            \exp_args:NnV \__technica_check_color_cycle:nn {#1}
              \l__technica_color_target_tl
          }
      }
  }

\cs_new_protected:Npn \technicadefinecolor #1#2
  {
    \definecolor{#1}{HTML}{#2}
    \cs_set:cpn {#1Hex} {#2}
    \prop_remove:Nn \l__technica_color_aliases_prop {#1}
    \__technica_refresh_colors:
  }

\cs_new_protected:Npn \technicaaliascolor #1#2
  {
    \bool_set_false:N \l__technica_color_cycle_bool
    \__technica_check_color_cycle:nn {#1} {#2}
    \bool_if:NTF \l__technica_color_cycle_bool
      {
        \PackageError{technica-colors}{Color~alias~cycle~for~`#1'}
          {An~alias~cannot~refer~to~itself,~directly~or~indirectly.}
      }
      {
        \prop_put:Nnn \l__technica_color_aliases_prop {#1} {#2}
        \__technica_refresh_colors:
      }
  }

\ExplSyntaxOff

\InputIfFileExists{themes/technica-colors-\technica@colors@theme.def}{}{%
    \PackageError{technica-colors}{%
        Theme `\technica@colors@theme' not found%
    }{%
        No file themes/technica-colors-\technica@colors@theme.def on the TeX path.%
        Shipping themes: light, dark.%
    }%
}

\endinput
