% Technica shell and terminal listings language.

\lstdefinestyle{technica-terminal}{
    style=technica-base,
    backgroundcolor=\color{TechnicaTerminalBg},
    alsoletter={$/.+-},
    keywords=[1]{$},
    % Shell reserved words (operators are punctuation, not command names).
    keywords=[2]{case,do,done,elif,else,esac,fi,for,if,in,then,until,while},
    % Portable shell builtins.
    morekeywords=[2]{alias,bg,break,cd,command,continue,echo,eval,exec,exit,export,
        false,fc,fg,getopts,jobs,kill,printf,pwd,read,readonly,return,set,
        shift,test,times,trap,true,type,ulimit,umask,unalias,unset,wait},
    % Common standard Unix utilities; exclude third-party tools and compilers.
    morekeywords=[2]{awk,basename,cat,chgrp,chmod,chown,cksum,cmp,comm,cp,cut,
        date,dd,df,diff,dirname,du,env,expand,expr,file,find,fold,grep,
        head,id,join,ln,locale,logger,ls,man,mkdir,mkfifo,mv,nice,nohup,od,
        paste,pathchk,pr,ps,rm,rmdir,sed,sh,sleep,sort,split,stty,tail,tee,
        time,touch,tr,tty,uname,unexpand,uniq,wc,who,xargs},
    sensitive=true,
    keywordstyle=[1]\color{TechnicaPrompt},
    keywordstyle=[2]\color{TechnicaCommand},
    commentstyle=\color{TechnicaComment},
    stringstyle=\color{TechnicaCommand}
}

\newtcblisting[use counter=technicacode]{terminal}[1][]{
    technica@code@listing=technica-terminal,
    colback=TechnicaTerminalBg,
    colframe=TechnicaTerminalBorder,
    colbacktitle=TechnicaPrompt!14!TechnicaTerminalBg,
    fonttitle=\technicaheadingfamily\small\bfseries,
    title=Terminal,
    #1
}

\technicadefineinlinecode{inlinesh}{technica-terminal}

\endinput
